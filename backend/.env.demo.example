# =============================================================================
# MadaRisk Map — MODE DÉMONSTRATION (base isolée)
# Copier vers .env.demo puis ajuster si besoin. Aucun secret réel ici.
# N'écrit JAMAIS dans la base normale mada_risk.
# =============================================================================

NODE_ENV=demo
DEMO_MODE=true
PORT=5001

# Base strictement locale et suffixée _demo (obligatoire).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mada_risk_demo

FRONTEND_URL=http://localhost:5174

# Sécurité : aucun job planifié, aucune publication automatique.
ENABLE_SCHEDULED_JOBS=false
ALERTS_AUTO_PUBLISH=false

# Appels externes neutralisés (adresse non routable).
OPEN_METEO_BASE_URL=http://127.0.0.1:9
DGM_MAPROOM_BASE_URL=http://127.0.0.1:9

# Répertoires de travail isolés.
REPORTS_DIR=uploads/demo/reports
IMPORTS_DIR=uploads/demo/imports

# Secrets de démonstration — à remplacer localement, jamais utilisés ailleurs.
JWT_ACCESS_SECRET=CHANGE_ME_DEMO_SECRET_MIN_16_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_DEMO_REFRESH_SECRET_MIN_16_CHARS

LOG_LEVEL=info

# --- Scénario (optionnel) ---------------------------------------------------
# Région / districts réels ciblés par le scénario « Cyclone Ankaratra ».
# DEMO_REGION_NAME=VAKINANKARATRA
# DEMO_DISTRICT_NAMES=ANTSIRABE I,ANTSIRABE II,AMBATOLAMPY

# --- Import géographique (optionnel) ----------------------------------------
# Chemin vers un dump SQL local (non versionné) du référentiel géographique.
# DEMO_GEOGRAPHY_DUMP=C:\chemin\vers\geographie.sql

# --- Sauvegarde / restauration (optionnel) ----------------------------------
# DEMO_DUMP_FILE=database/demo-dumps/mada_risk_demo.dump
