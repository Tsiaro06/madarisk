NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://postgres:postgres@192.168.100.31:5432/mada_risk
# Base distante PC B — ne pas lancer db:migrate / db:seed dessus
# (protégé sauf si ALLOW_DB_MIGRATE=true)
DB_HOST=192.168.100.31
DB_PORT=5432
DB_NAME=mada_risk
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

JWT_ACCESS_SECRET=remplacer_par_une_cle_longue_aleatoire_access
JWT_REFRESH_SECRET=remplacer_par_une_autre_cle_longue_aleatoire_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

FRONTEND_URL=http://localhost:5173

OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_TIMEOUT_MS=10000

# Source officielle DGM — pluie décadaire (maproom IRI Data Library), ingérée par le job quotidien
DGM_MAPROOM_BASE_URL=https://map.meteomadagascar.mg
DGM_MAPROOM_TIMEOUT_MS=20000
DGM_MAPROOM_MAX_DISTANCE_DEG=0.1
DGM_MAPROOM_INGEST_CRON=0 6 * * *

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=2

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

REPORTS_DIR=uploads/reports
IMPORTS_DIR=uploads/imports

ENABLE_SCHEDULED_JOBS=true
# WEATHER_REFRESH_CRON est conservé pour compatibilité (défaut de WEATHER_OBSERVATION_CRON)
WEATHER_REFRESH_CRON=0 6 * * *
# Synchronisation automatique : UNE seule synchro d'observations par jour (06 h),
# prévisions une fois par jour (12 h 20), décalées après le reset du quota à
# 03:00 heure Madagascar. Cadence limitée par le quota gratuit Open-Meteo
# (10 000 coordonnées/jour, 5 000/heure, 600/minute) :
# un run national sur 1579 communes coûte ~1580 coordonnées, donc 1 + 1 runs/jour
# laissent ~6800 coordonnées de marge pour les relances manuelles.
WEATHER_OBSERVATION_CRON=0 6 * * *
WEATHER_FORECAST_CRON=20 12 * * *
# Fraîcheur des données exposée par GET /api/v1/weather/monitoring.
# Seuils = période du cron + 1 h de marge, pour ne pas rougir pendant un cycle normal.
WEATHER_OBSERVATION_STALE_MINUTES=1500
WEATHER_FORECAST_STALE_HOURS=26
RISK_RECALCULATION_CRON=10 * * * *

# Détection automatique d'aléas (appliquée après chaque sync météo et après
# chaque rafraîchissement manuel depuis l'UI).
DETECTION_NORMAL_CYCLES_BEFORE_MONITORING=3
DETECTION_MONITORING_HOURS=24
DETECTION_DEDUPE_HOURS=48
# true = les alertes générées automatiquement sont publiées directement
# (statut PUBLIEE, visibles dans la salle de crise) ; false = brouillon
# à valider manuellement.
ALERTS_AUTO_PUBLISH=true

LOG_LEVEL=info
