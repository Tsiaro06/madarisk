NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://postgres:postgres@192.168.100.31:5432/mada_risk
# Base distante PC B — ne pas lancer db:migrate / db:seed dessus
# (protégé sauf si ALLOW_DB_MIGRATE=true)
DB_HOST=192.168.100.31
DB_PORT=5432
DB_NAME=mada_risk
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

JWT_ACCESS_SECRET=remplacer_par_une_cle_longue_aleatoire_access
JWT_REFRESH_SECRET=remplacer_par_une_autre_cle_longue_aleatoire_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

FRONTEND_URL=http://localhost:5173

OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_TIMEOUT_MS=10000

# Source officielle DGM — pluie décadaire (maproom IRI Data Library), ingérée par le job quotidien
DGM_MAPROOM_BASE_URL=https://map.meteomadagascar.mg
DGM_MAPROOM_TIMEOUT_MS=20000
DGM_MAPROOM_MAX_DISTANCE_DEG=0.1
DGM_MAPROOM_INGEST_CRON=0 6 * * *

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

REPORTS_DIR=uploads/reports
IMPORTS_DIR=uploads/imports

ENABLE_SCHEDULED_JOBS=true
WEATHER_REFRESH_CRON=0 */4 * * *
RISK_RECALCULATION_CRON=10 * * * *

LOG_LEVEL=info
