NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mada_risk
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mada_risk
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

JWT_ACCESS_SECRET=remplacer_par_une_cle_longue_aleatoire_access
JWT_REFRESH_SECRET=remplacer_par_une_autre_cle_longue_aleatoire_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

FRONTEND_URL=http://localhost:5173

OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_TIMEOUT_MS=10000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

REPORTS_DIR=uploads/reports
IMPORTS_DIR=uploads/imports

ENABLE_SCHEDULED_JOBS=false
WEATHER_REFRESH_CRON=0 * * * *
RISK_RECALCULATION_CRON=10 * * * *

LOG_LEVEL=info
